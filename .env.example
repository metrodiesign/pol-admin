# Google OAuth client IDs — Sign in with Google (REQ-6.1, 6.3)
# client_id เป็นค่า public ของ OAuth (ไม่ใช่ secret); GIS ID-token flow ไม่ใช้ client secret ฝั่ง frontend.
# สร้าง OAuth 2.0 Client (Web application) 2 ตัวใน Google Cloud Console แล้วใส่ค่าจริงใน .env.local (gitignored).
NEXT_PUBLIC_GOOGLE_CLIENT_ID_ADMIN=your-admin-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID_PRODUCER=your-producer-client-id.apps.googleusercontent.com
