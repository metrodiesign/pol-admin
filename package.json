{
  "name": "pol-admin",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "npm run dev:admin",
    "dev:admin": "npm run dev --workspace=@pol/admin",
    "dev:merchant": "npm run dev --workspace=@pol/merchant",
    "dev:clean": "npm run dev:clean --workspace=@pol/admin",
    "build": "npm run build:admin",
    "build:admin": "npm run build --workspace=@pol/admin",
    "build:merchant": "npm run build --workspace=@pol/merchant",
    "start": "npm run start:admin",
    "start:admin": "npm run start --workspace=@pol/admin",
    "start:merchant": "npm run start --workspace=@pol/merchant",
    "test": "node --test scripts/lib/workspace-verification.test.mjs && npm run test --workspaces --if-present",
    "test:admin": "npm run test --workspace=@pol/admin",
    "test:merchant": "npm run test --workspace=@pol/merchant",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify:workspaces": "node scripts/verify-workspaces.mjs",
    "smoke:routes": "node scripts/smoke-workspace-routes.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "shadcn": "4.8.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
